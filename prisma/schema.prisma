generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== ПРОЕКТЫ ====================

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("active") // active, paused, completed, archived
  color       String   @default("#6366f1")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  nodes Node[]
}

// ==================== УЗЛЫ ДЕРЕВА ====================

model Node {
  id         String   @id @default(cuid())
  projectId  String
  parentId   String?
  name       String
  nodeType   String   @default("item")  // branch, item
  branchType String?                    // Для будущей типизации: tasks, infrastructure, credentials, artifacts и т.д.
  fields     String   @default("{}")    // JSON: произвольные поля элемента
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   Node?   @relation("NodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Node[]  @relation("NodeTree")

  @@index([projectId])
  @@index([parentId])
}
