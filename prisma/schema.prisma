generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== ПРОЕКТЫ ====================

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("active") // active, paused, completed, archived
  color       String   @default("#6366f1")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks          Task[]
  categories     TaskCategory[]
  artifacts      Artifact[]
  credentials    Credential[]
  infrastructure InfrastructureItem[]
  sprints        Sprint[]
}

// ==================== КАТЕГОРИИ ЗАДАЧ ====================

model TaskCategory {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#6b7280")
  projectId String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]
}

// ==================== СПРИНТЫ ====================

model Sprint {
  id        String    @id @default(cuid())
  name      String
  startDate DateTime?
  endDate   DateTime?
  status    String    @default("planning") // planning, active, completed
  projectId String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]
}

// ==================== ЗАДАЧИ ====================

model Task {
  id           String   @id @default(cuid())
  title        String
  description  String?
  status       String   @default("todo") // todo, in_progress, review, done, cancelled
  priority     String   @default("medium") // low, medium, high, critical
  workItemType String   @default("task") // epic, feature, userStory, bug, task
  parentId     String?
  sprintId     String?
  order        Int      @default(0)
  projectId    String
  categoryId   String?
  dueDate      DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category  TaskCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sprint    Sprint?      @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  parent    Task?        @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Task[]       @relation("TaskHierarchy")
}

// ==================== АРТЕФАКТЫ ====================

model Artifact {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   @default("document") // document, letter, contract, report, other
  fileName    String?
  fileContent String?
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ==================== УЧЁТНЫЕ ЗАПИСИ ====================

model Credential {
  id          String   @id @default(cuid())
  service     String
  username    String
  password    String
  url         String?
  notes       String?
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ==================== ИНФРАСТРУКТУРА ====================

model InfrastructureItem {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("server") // server, database, service, api, storage, other
  host        String?
  port        String?
  credentials String?
  description String?
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
