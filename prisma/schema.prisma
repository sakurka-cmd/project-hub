generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== ПОЛЬЗОВАТЕЛИ ====================

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  role      String   @default("user") // admin, user
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]
}

// ==================== СИСТЕМНЫЕ НАСТРОЙКИ ====================

model SystemSetting {
  key   String @id
  value String
}

// ==================== ПОРТФЕЛИ (ГРУППИРОВКА ПРОЕКТОВ) ====================

model Portfolio {
  id          String   @id @default(cuid())
  name        String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects Project[]
}

// ==================== ПРОЕКТЫ ====================

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("active")
  color       String   @default("#6366f1")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodes       Node[]
  portfolioId String?
  portfolio   Portfolio?  @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
}

// ==================== УЗЛЫ ДЕРЕВА ====================

model Node {
  id             String   @id @default(cuid())
  projectId      String
  parentId       String?
  name           String
  nodeType       String   @default("item") // branch, item, task, protocol
  branchType     String?
  elementTypeId  String?
  taskTypeId     String?
  completed      Boolean  @default(false)
  fields         String   @default("{}")
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent       Node?        @relation("NodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     Node[]       @relation("NodeTree")
  attachments  FileAttachment[]
  elementType  ElementType? @relation(fields: [elementTypeId], references: [id], onDelete: SetNull)
  taskType     TaskType?    @relation(fields: [taskTypeId], references: [id], onDelete: SetNull)
}

// ==================== ПРИКРЕПЛЁННЫЕ ФАЙЛЫ ====================

model FileAttachment {
  id           String   @id @default(cuid())
  nodeId       String
  fileName     String
  originalName String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId])
}

// ==================== ТИПЫ ЭЛЕМЕНТОВ ====================

model ElementType {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#6366f1")
  fields      String   @default("[]") // JSON: [{key, defaultValue}]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  nodes Node[]
}

// ==================== ТИПЫ ЗАДАЧ ====================

model TaskType {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#6366f1")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  nodes Node[]
}
